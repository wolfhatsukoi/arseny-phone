    },
    {
      "id": "6f879721-0d14-4994-98f0-5331c8b60f32",
      "contactId": "",
      "messages": [
        {
          "id": "1bb17b3b-fde3-43a9-82b2-1d37c957b900",
          "kind": "date",
          "text": "11월 12일 목요일",
          "dateParts": {
            "mode": "calendar",
            "month": 11,
            "day": 12,
            "weekday": 4
          }
        },
        {
          "id": "4dee4587-bb8c-4f17-8d20-ebd84b9226ee",
          "from": "them",
          "text": "개새끼야",
          "time": "10:44"
        },
        {
          "id": "847fe5ee-f74c-4ca1-8c65-37e51e03053e",
          "from": "them",
          "text": "내가 맞춤법 공부하랬어 안하랬어",
          "time": "10:44"
        },
        {
          "id": "4e7c157c-cae6-4991-a4e6-28dcc4990453",
          "from": "them",
          "text": "하중초가 시발 초가집이냐",
          "time": "10:44"
        },
        {
          "id": "a7d43e50-a024-4e55-91be-1b022095988d",
          "from": "them",
          "text": "모르면 맨날 니가 보러가는 사서한테 알려달라고해",
          "time": "10:44"
        },
        {
          "id": "1d31cae7-4646-4a90-881b-783e8f1dca36",
          "from": "me",
          "text": "ㅇ",
          "time": "10:44"
        }
      ],
      "draft": "근데 걔가 사서인지 어떻게 알",
      "name": "대머리",
